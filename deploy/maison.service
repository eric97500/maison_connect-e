[Unit]
Description=Maison connectée
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__DIR__/.venv/bin/python -m app.main
Restart=always
RestartSec=5
# Wake on LAN et recherche réseau ont besoin d'envoyer des paquets broadcast
AmbientCapabilities=CAP_NET_RAW CAP_NET_BROADCAST

[Install]
WantedBy=multi-user.target
