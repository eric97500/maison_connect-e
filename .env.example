# Copier ce fichier en ".env" puis remplir. Ne jamais partager le fichier .env.

# Mot de passe de l'interface (vide = pas de mot de passe, déconseillé)
DASHBOARD_PASSWORD=

# Compte TP-Link / Tapo (le même que dans l'app Tapo)
TAPO_EMAIL=
TAPO_PASSWORD=

# Verisure
VERISURE_EMAIL=
VERISURE_PASSWORD=

# Caméras Avidsen
CAMERA_USER=admin
CAMERA_PASSWORD=

# NAS TerraMaster (accès SSH de TOS, port 9222)
TERRAMASTER_USER=
TERRAMASTER_PASSWORD=

# Serveurs Linux (SSH)
LINUX_USER=
LINUX_PASSWORD=

# Switch TP-Link Easy Smart (TL-SG1016DE…) : compte de son interface web
SWITCH_USER=admin
SWITCH_PASSWORD=

# Box Internet (compte administrateur de leur interface web)
SFR_USER=admin
SFR_PASSWORD=
LIVEBOX_USER=admin
LIVEBOX_PASSWORD=

# NAS QNAP
QNAP_USER=admin
QNAP_PASSWORD=

# Proxmox (jeton API : Datacenter > Permissions > API Tokens)
PROXMOX_USER=root@pam
PROXMOX_TOKEN_NAME=maison
PROXMOX_TOKEN_VALUE=
